  horizonteTexto       String?
  investimentoPrevisto Decimal? @db.Decimal(14, 2)
  status               String   @default("Em andamento")
  atualizadoEm         DateTime @default(now())
  createdAt            DateTime @default(now())

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
}

