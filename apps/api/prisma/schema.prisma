  estabelecimento    Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamento        Equipamento        @relation(fields: [equipamentoId], references: [id])
  procedimento       ProcedimentoLaudo? @relation(fields: [procedimentoId], references: [id])
  instrumento        InstrumentoPadrao? @relation(fields: [instrumentoId], references: [id])
  responsavelTecnico Colaborador?       @relation("LaudoResponsavelTecnico", fields: [responsavelTecnicoId], references: [id])
  planoTeste         PlanoTeste?        @relation(fields: [planoTesteId], references: [id], onDelete: SetNull)
  anexos             LaudoAnexo[]
  ocorrenciasPlano   PlanoOcorrencia[]
  revisoes           LaudoRevisao[]

  @@unique([estabelecimentoId, numero])
  @@index([estabelecimentoId, tipo])
  @@index([estabelecimentoId, statusDocumento])
  @@index([equipamentoId])
