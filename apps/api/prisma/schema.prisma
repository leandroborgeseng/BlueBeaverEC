generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilAcesso {
  ENGENHEIRO
  GESTOR
  TECNICO
  SOLICITANTE
  AUDITORIA
  ADMIN
}

enum SituacaoEquipamento {
  ATIVO
  EM_GARANTIA
  EM_GARANTIA_ESTENDIDA
  INATIVO
  ARQUIVADO
}

enum Criticidade {
  BAIXA
  MEDIA
  ALTA
}

enum PrioridadeOS {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusOS {
  NAO_ATRIBUIDA
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TipoOS {
  CORRETIVA
  PREVENTIVA
  CALIBRACAO
  TSE
}

enum UrgenciaSolicitacao {
  BAIXA
  MEDIA
  ALTA
  PARADA_CRITICA
}

enum StatusSolicitacao {
  PENDENTE
  CONVERTIDA
  RECUSADA
}

model Estabelecimento {
  id              String   @id @default(cuid())
  nome            String
  cnpj            String?
  fusoHorario     String   @default("America/Sao_Paulo")
  slaUrgenteHoras Int      @default(4)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usuarios               UsuarioEstabelecimento[]
  setores                Setor[]
  fabricantes            Fabricante[]
  fornecedores           Fornecedor[]
  planosDescricao        PlanoDescricao[]
  equipamentos           Equipamento[]
  ordensServico          OrdemServico[]
  solicitacoes           SolicitacaoServico[]
  estoqueItens           EstoqueItem[]
  procedimentosLaudo     ProcedimentoLaudo[]
  instrumentos           InstrumentoPadrao[]
  laudos                 Laudo[]
  contratos              Contrato[]
  equipes                Equipe[]
  componentesRecuperados ComponenteRecuperado[]
  auditorias             Auditoria[]
  naoConformidades       NaoConformidade[]
  avaliacoesMaturidade   AvaliacaoMaturidade[]
  jornadaEvolucao        JornadaEvolucao?
  evidenciasConformidade EvidenciaConformidade[]
  pops                   Pop[]
  recomendacoes          RecomendacaoInstitucional[]
  indicadores            Indicador[]
  planosDiretor          PlanoDiretorItem[]
  capexItens             CapexItem[]
  relatorioAgendamentos  RelatorioAgendamento[]
  perfisCustom           PerfilCustom[]
  mobileSyncIds          MobileSyncIdempotency[]
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  senhaHash    String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  estabelecimentos UsuarioEstabelecimento[]
  colaborador      Colaborador?
  logsAcesso       LogAcesso[]
  historicoTags    HistoricoTag[]
  logsOS           LogOrdemServico[]
}

model UsuarioEstabelecimento {
  id                 String       @id @default(cuid())
  usuarioId          String
  estabelecimentoId  String
  perfil             PerfilAcesso
  setorIds           String[]     @default([])

  usuario         Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, estabelecimentoId])
}

model LogAcesso {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String
  detalhe   String?
  ip        String?
  createdAt DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
}

model Setor {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  nome               String
  ativo              Boolean @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamentos    Equipamento[]

  @@unique([estabelecimentoId, nome])
}

model Fabricante {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  nome               String
  ativo              Boolean @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  modelos         Modelo[]
  equipamentos    Equipamento[]

  @@unique([estabelecimentoId, nome])
}

model Modelo {
  id            String @id @default(cuid())
  fabricanteId  String
  nome          String
  ativo         Boolean @default(true)

  fabricante   Fabricante    @relation(fields: [fabricanteId], references: [id], onDelete: Cascade)
  equipamentos Equipamento[]
  procedimentos ProcedimentoModelo[]

  @@unique([fabricanteId, nome])
}

model Fornecedor {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  nome               String
  cnpj               String?
  ativo              Boolean @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamentos    Equipamento[]
  contratos       Contrato[]

  @@unique([estabelecimentoId, nome])
}

model PlanoDescricao {
  id                 String      @id @default(cuid())
  estabelecimentoId  String
  nome               String
  criticidade        Criticidade @default(MEDIA)
  vidaUtilAnos       Int         @default(10)
  ativo              Boolean     @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamentos    Equipamento[]

  @@unique([estabelecimentoId, nome])
}

model CentroCusto {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  codigo             String
  nome               String
  ativo              Boolean @default(true)

  equipamentos Equipamento[]

  @@unique([estabelecimentoId, codigo])
}

model Colaborador {
  id                 String  @id @default(cuid())
  estabelecimentoId  String
  usuarioId          String? @unique
  matricula          String
  nome               String
  cargo              String?
  registroProfissional String?
  ativo              Boolean @default(true)

  usuario          Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  osResponsavel    OrdemServico[] @relation("OSResponsavel")
  laudosResponsavel Laudo[]       @relation("LaudoResponsavelTecnico")
  equipes          EquipeMembro[]
  competencias     Competencia[]
  auditoriasResp   Auditoria[]    @relation("AuditoriaResponsavel")

  @@unique([estabelecimentoId, matricula])
}

model Equipamento {
  id                 String               @id @default(cuid())
  estabelecimentoId  String
  tag                String
  nome               String
  descricaoId        String
  fabricanteId       String
  modeloId           String
  setorId            String
  fornecedorId       String?
  centroCustoId      String?
  patrimonio         String?
  nSerie             String?
  dataAquisicao      DateTime?
  valorAquisicao     Decimal?             @db.Decimal(14, 2)
  valorSubstituicao  Decimal?             @db.Decimal(14, 2)
  situacao           SituacaoEquipamento  @default(ATIVO)
  checklistRecebimentoPendente Boolean    @default(true)
  registroAnvisa     String?
  validadeAnvisa     DateTime?
  dataEndOfService   DateTime?
  dataEndOfLife      DateTime?
  observacao         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  descricao       PlanoDescricao  @relation(fields: [descricaoId], references: [id])
  fabricante      Fabricante      @relation(fields: [fabricanteId], references: [id])
  modelo          Modelo          @relation(fields: [modeloId], references: [id])
  setor           Setor           @relation(fields: [setorId], references: [id])
  fornecedor      Fornecedor?     @relation(fields: [fornecedorId], references: [id])
  centroCusto     CentroCusto?    @relation(fields: [centroCustoId], references: [id])
  historicoTags   HistoricoTag[]
  ordensServico   OrdemServico[]
  solicitacoes    SolicitacaoServico[]
  laudos          Laudo[]
  contratos       ContratoEquipamento[]
  componentesOrigem ComponenteRecuperado[] @relation("CompOrigem")
  componentesDestino ComponenteRecuperado[] @relation("CompDestino")

  @@unique([estabelecimentoId, tag])
  @@index([estabelecimentoId, situacao])
  @@index([setorId])
}

model HistoricoTag {
  id            String   @id @default(cuid())
  equipamentoId String
  tagAnterior   String
  tagNova       String
  justificativa String
  usuarioId     String
  createdAt     DateTime @default(now())

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
}

model OrdemServico {
  id                 String       @id @default(cuid())
  estabelecimentoId  String
  numero             Int
  codigo             String?
  equipamentoId      String
  tipo               TipoOS       @default(CORRETIVA)
  oficina            String?
  prioridade         PrioridadeOS @default(MEDIA)
  status             StatusOS     @default(NAO_ATRIBUIDA)
  abertura            DateTime     @default(now())
  fechamento         DateTime?
  responsavelId      String?
  pendencia          String?
  observacaoRequisicao String?
  solicitacaoId      String?      @unique
  contratoId         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  estabelecimento Estabelecimento     @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamento     Equipamento         @relation(fields: [equipamentoId], references: [id])
  responsavel     Colaborador?        @relation("OSResponsavel", fields: [responsavelId], references: [id])
  solicitacao     SolicitacaoServico? @relation(fields: [solicitacaoId], references: [id])
  logs            LogOrdemServico[]
  itens           OrdemServicoItem[]
  reservas        EstoqueReserva[]
  contrato        Contrato?           @relation(fields: [contratoId], references: [id])
  naoConformidades NaoConformidade[]
  checklistMobile OsChecklistMobile?
  fotosMobile     OsFotoMobile[]

  @@unique([estabelecimentoId, numero])
  @@index([estabelecimentoId, status])
  @@index([equipamentoId])
}

model LogOrdemServico {
  id             String   @id @default(cuid())
  ordemServicoId String
  usuarioId      String?
  acao           String
  justificativa  String?
  createdAt      DateTime @default(now())

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  usuario      Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
}

model SolicitacaoServico {
  id                 String              @id @default(cuid())
  estabelecimentoId  String
  protocolo          String
  equipamentoId      String?
  setorNome          String
  descricao          String
  urgencia           UrgenciaSolicitacao @default(MEDIA)
  solicitanteNome    String
  ramal              String?
  status             StatusSolicitacao   @default(PENDENTE)
  justificativaRecusa String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamento     Equipamento?    @relation(fields: [equipamentoId], references: [id])
  ordemServico    OrdemServico?

  @@unique([estabelecimentoId, protocolo])
  @@index([estabelecimentoId, status])
}

model ContadorSequencia {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  chave              String
  valor              Int    @default(0)

  @@unique([estabelecimentoId, chave])
}

enum TipoItemOS {
  MATERIAL
  MAO_DE_OBRA
}

model OrdemServicoItem {
  id             String     @id @default(cuid())
  ordemServicoId String
  tipo           TipoItemOS @default(MATERIAL)
  descricao      String
  quantidade     Decimal    @db.Decimal(12, 2) @default(1)
  valorUnitario  Decimal?   @db.Decimal(14, 2)
  estoqueItemId  String?

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  estoqueItem  EstoqueItem? @relation(fields: [estoqueItemId], references: [id])
}

model EstoqueItem {
  id                 String  @id @default(cuid())
  estabelecimentoId  String
  codigo             String
  descricao          String
  almoxarifado       String  @default("Principal")
  qtdAtual           Decimal @db.Decimal(12, 2) @default(0)
  qtdMinima          Decimal @db.Decimal(12, 2) @default(0)
  valorUnitario      Decimal @db.Decimal(14, 2) @default(0)
  ativo              Boolean @default(true)

  estabelecimento Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  reservas        EstoqueReserva[]
  itensOS         OrdemServicoItem[]

  @@unique([estabelecimentoId, codigo])
}

model EstoqueReserva {
  id            String   @id @default(cuid())
  estoqueItemId String
  ordemServicoId String
  quantidade    Decimal  @db.Decimal(12, 2)
  ativa         Boolean  @default(true)
  createdAt     DateTime @default(now())

  estoqueItem  EstoqueItem  @relation(fields: [estoqueItemId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
}

enum TipoLaudo {
  RECEBIMENTO
  PREVENTIVA
  CALIBRACAO
  TSE
}

enum ResultadoLaudo {
  APROVADO
  REPROVADO
  APROVADO_COM_RESSALVAS
}

enum NormaTse {
  FABRICA
  EC
}

enum StatusCertificado {
  VALIDO
  A_VENCER
  VENCIDO
}

model ProcedimentoLaudo {
  id                 String    @id @default(cuid())
  estabelecimentoId  String
  nome               String
  tipo               TipoLaudo
  validadeMeses      Int       @default(12)
  /// Itens do procedimento: perguntas | pontos | testes (JSON conforme tipo)
  itens              Json      @default("[]")
  ativo              Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  estabelecimento Estabelecimento      @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  modelos         ProcedimentoModelo[]
  laudos          Laudo[]
  pop             Pop?

  @@index([estabelecimentoId, tipo])
}

model ProcedimentoModelo {
  id              String @id @default(cuid())
  procedimentoId  String
  modeloId        String

  procedimento ProcedimentoLaudo @relation(fields: [procedimentoId], references: [id], onDelete: Cascade)
  modelo       Modelo            @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@unique([procedimentoId, modeloId])
  @@index([modeloId])
}

model InstrumentoPadrao {
  id                 String    @id @default(cuid())
  estabelecimentoId  String
  nome               String
  nSerie             String
  certificadoNumero  String?
  certificadoEmissao DateTime?
  certificadoValidade DateTime?
  laboratorioEmissor String?
  ativo              Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  laudos          Laudo[]

  @@unique([estabelecimentoId, nSerie])
}

model Laudo {
  id                   String         @id @default(cuid())
  estabelecimentoId    String
  tipo                 TipoLaudo
  numero               String
  equipamentoId        String
  osNumero             Int?
  dataExecucao         DateTime       @default(now())
  tecnicoNome          String?
  responsavelTecnicoId String?
  procedimentoId       String?
  instrumentoId        String?
  resultado            ResultadoLaudo?
  justificativaRessalva String?
  validadeMeses        Int?
  validadeAte          DateTime?
  /// Checklist / pontos / testes preenchidos
  respostas            Json           @default("[]")
  /// Campos extras por tipo (NF, norma TSE, critério %, próxima preventiva...)
  metadados            Json           @default("{}")
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  estabelecimento    Estabelecimento   @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamento        Equipamento       @relation(fields: [equipamentoId], references: [id])
  procedimento       ProcedimentoLaudo? @relation(fields: [procedimentoId], references: [id])
  instrumento        InstrumentoPadrao? @relation(fields: [instrumentoId], references: [id])
  responsavelTecnico Colaborador?      @relation("LaudoResponsavelTecnico", fields: [responsavelTecnicoId], references: [id])

  @@unique([estabelecimentoId, numero])
  @@index([estabelecimentoId, tipo])
  @@index([equipamentoId])
}

enum SituacaoContrato {
  VIGENTE
  A_VENCER
  VENCIDO
}

enum IndiceReajuste {
  IPCA
  IGP_M
}

model Contrato {
  id                    String           @id @default(cuid())
  estabelecimentoId     String
  numero                String
  fornecedorId          String
  descricao             String
  situacao              SituacaoContrato @default(VIGENTE)
  vigenciaInicio        DateTime
  vigenciaFim           DateTime
  valor                 Decimal          @db.Decimal(14, 2)
  slaAtendimentoHoras   Int?
  slaSolucaoHoras       Int?
  indiceReajuste        IndiceReajuste?
  dataReajusteAniversario DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  estabelecimento Estabelecimento        @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  fornecedor      Fornecedor             @relation(fields: [fornecedorId], references: [id])
  equipamentos    ContratoEquipamento[]
  glosas          ContratoGlosa[]
  ordensServico   OrdemServico[]

  @@unique([estabelecimentoId, numero])
  @@index([estabelecimentoId, situacao])
}

model ContratoEquipamento {
  id            String @id @default(cuid())
  contratoId    String
  equipamentoId String

  contrato    Contrato    @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@unique([contratoId, equipamentoId])
}

model ContratoGlosa {
  id         String   @id @default(cuid())
  contratoId String
  data       DateTime @default(now())
  valor      Decimal  @db.Decimal(14, 2)
  motivo     String

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
}

model Equipe {
  id                 String  @id @default(cuid())
  estabelecimentoId  String
  nome               String
  turno              String?
  liderId            String?
  ativo              Boolean @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  membros         EquipeMembro[]

  @@unique([estabelecimentoId, nome])
}

model EquipeMembro {
  id             String @id @default(cuid())
  equipeId       String
  colaboradorId  String

  equipe      Equipe      @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([equipeId, colaboradorId])
}

model Competencia {
  id             String    @id @default(cuid())
  colaboradorId  String
  nome           String
  nivel          String?
  validade       DateTime?

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
}

enum SituacaoComponenteRecuperado {
  EM_RASTREAMENTO
  REAPROVEITADO
  DESCARTADO
}

model ComponenteRecuperado {
  id                    String                       @id @default(cuid())
  estabelecimentoId     String
  itemDescricao         String
  equipamentoOrigemId   String
  dataRetirada          DateTime                     @default(now())
  situacao              SituacaoComponenteRecuperado @default(EM_RASTREAMENTO)
  equipamentoDestinoId  String?
  osDestinoNumero       Int?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  estabelecimento    Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamentoOrigem  Equipamento     @relation("CompOrigem", fields: [equipamentoOrigemId], references: [id])
  equipamentoDestino Equipamento?    @relation("CompDestino", fields: [equipamentoDestinoId], references: [id])
}

enum StatusAuditoria {
  PLANEJADA
  EM_EXECUCAO
  CONCLUIDA
}

enum StatusNC {
  ABERTA
  EM_ACAO
  FECHADA
}

model Auditoria {
  id                 String         @id @default(cuid())
  estabelecimentoId  String
  codigo             String
  escopo             String
  responsavelId      String?
  data               DateTime       @default(now())
  status             StatusAuditoria @default(PLANEJADA)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  estabelecimento Estabelecimento  @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  responsavel     Colaborador?     @relation("AuditoriaResponsavel", fields: [responsavelId], references: [id])
  achados         NaoConformidade[]
}

model NaoConformidade {
  id                 String   @id @default(cuid())
  estabelecimentoId  String
  codigo             String
  descricao          String
  origem             String
  status             StatusNC @default(ABERTA)
  auditoriaId        String?
  ordemServicoId     String?
  justificativaFechamento String?
  justificativaReabertura String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  auditoria       Auditoria?      @relation(fields: [auditoriaId], references: [id])
  ordemServico    OrdemServico?   @relation(fields: [ordemServicoId], references: [id])
  planosAcao      PlanoAcao[]

  @@unique([estabelecimentoId, codigo])
}

model PlanoAcao {
  id                 String    @id @default(cuid())
  naoConformidadeId  String
  descricao          String
  responsavelNome    String?
  prazo              DateTime?
  concluidoEm        DateTime?
  escalonadoEm       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  naoConformidade NaoConformidade @relation(fields: [naoConformidadeId], references: [id], onDelete: Cascade)
}

// ——— Fase 4/5: Estratégico, Indicadores, CAPEX, Relatórios, Config ———

model DominioMaturidade {
  id     String @id @default(cuid())
  codigo String @unique
  nome   String
  ordem  Int
  peso   Float  @default(1)

  avaliacoes AvaliacaoMaturidade[]
}

model AvaliacaoMaturidade {
  id                 String   @id @default(cuid())
  estabelecimentoId  String
  dominioId          String
  nivel              Int // 1-5
  gaps               Json     @default("[]")
  evidencias         Json     @default("[]")
  planoAcao          String?
  avaliadoEm         DateTime @default(now())
  avaliadoPorId      String?
  updatedAt          DateTime @updatedAt

  estabelecimento Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  dominio         DominioMaturidade  @relation(fields: [dominioId], references: [id], onDelete: Cascade)

  @@unique([estabelecimentoId, dominioId])
}

enum EtapaJornada {
  DIAGNOSTICO
  PRIORIZACAO
  PLANO
  IMPLANTACAO
  EVIDENCIAS
  AVALIACAO
  MELHORIA_CONTINUA
}

model JornadaEvolucao {
  id                 String       @id @default(cuid())
  estabelecimentoId  String       @unique
  etapaAtual         EtapaJornada @default(DIAGNOSTICO)
  notas              Json         @default("{}")
  updatedAt          DateTime     @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
}

model RequisitoNormativo {
  id        String  @id @default(cuid())
  codigo    String  @unique
  norma     String
  texto     String
  categoria String
  ativo     Boolean @default(true)

  evidencias EvidenciaConformidade[]
}

enum StatusConformidade {
  CONFORME
  PARCIAL
  NAO_CONFORME
  SEM_EVIDENCIA
}

model EvidenciaConformidade {
  id                 String             @id @default(cuid())
  estabelecimentoId  String
  requisitoId        String
  tipo               String
  descricao          String?
  arquivoUrl         String?
  status             StatusConformidade @default(SEM_EVIDENCIA)
  dataUpload         DateTime           @default(now())
  uploadedById       String?

  estabelecimento Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  requisito       RequisitoNormativo @relation(fields: [requisitoId], references: [id], onDelete: Cascade)

  @@index([estabelecimentoId, requisitoId])
}

model Pop {
  id                   String   @id @default(cuid())
  estabelecimentoId    String
  codigo               String
  titulo               String
  versao               String   @default("1.0")
  status               String   @default("VIGENTE")
  procedimentoLaudoId  String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  estabelecimento   Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  procedimentoLaudo ProcedimentoLaudo? @relation(fields: [procedimentoLaudoId], references: [id])

  @@unique([estabelecimentoId, codigo])
}

model RecomendacaoInstitucional {
  id                 String   @id @default(cuid())
  estabelecimentoId  String
  titulo             String
  origem             String
  prioridade         String   @default("MEDIA")
  responsavelNome    String?
  concluida          Boolean  @default(false)
  createdAt          DateTime @default(now())

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
}

enum FormulaIndicador {
  PERCENTUAL
  CONTAGEM
  MEDIA
  SOMA
}

model Indicador {
  id                 String           @id @default(cuid())
  estabelecimentoId  String?
  codigo             String           @unique
  nome               String
  categoria          String
  metaTexto          String?
  metaNum            Float?
  formula            FormulaIndicador @default(CONTAGEM)
  campos             Json             @default("[]")
  sistema            Boolean          @default(false)
  ativo              Boolean          @default(true)
  createdAt          DateTime         @default(now())

  estabelecimento Estabelecimento?     @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  snapshots       IndicadorSnapshot[]
}

model IndicadorSnapshot {
  id          String   @id @default(cuid())
  indicadorId String
  periodo     String // YYYY-MM
  valor       Float
  createdAt   DateTime @default(now())

  indicador Indicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)

  @@unique([indicadorId, periodo])
}

model PlanoDiretorItem {
