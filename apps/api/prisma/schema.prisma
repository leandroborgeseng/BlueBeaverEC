// ——— Qualidade: documentos controlados, treinamentos, ocorrências e alertas de campo ———

enum CategoriaDocumentoControlado {
  PROCEDIMENTO
  INSTRUCAO
  INSTITUCIONAL
}

enum StatusDocumentoControlado {
  RASCUNHO
  VIGENTE
  OBSOLETO
}

enum OrigemDocumentoControlado {
  INSTITUCIONAL
  BIBLIOTECA_POP
}

enum TipoVinculoDocumento {
  EQUIPAMENTO
  MODELO
  INTERVENCAO
  SETOR
}

enum TipoTreinamentoQualidade {
  INICIAL
  RECICLAGEM
  EDUCACAO_CONTINUADA
}

enum TipoOcorrenciaSeguranca {
  FALHA
  INCIDENTE
  SUSPEITA_EVENTO_ADVERSO
}

enum StatusOcorrenciaSeguranca {
  ABERTA
  EM_INVESTIGACAO
  ACOES_EM_ANDAMENTO
  CONCLUIDA
}

enum TipoAlertaCampo {
  ALERTA_FABRICANTE
  RECOLHIMENTO
  ACAO_DE_CAMPO
}

enum StatusAlertaCampo {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
}

/// Arquivo único reutilizado (documento, evidência de treino, ocorrência, alerta).
model ArquivoQualidade {
  id                 String   @id @default(cuid())
  estabelecimentoId  String
  nomeArquivo        String
  mimeType           String
  conteudo           Bytes
  tamanhoBytes       Int
  createdById        String?
  createdAt          DateTime @default(now())

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  createdBy       Usuario?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versoes         DocumentoVersao[]
  treinamentos    Treinamento[]
  evidenciasTreino TreinamentoEvidencia[]
  acoesOcorrencia OcorrenciaAcao[]
  evidenciasOcorrencia OcorrenciaArquivo[]
  evidenciasAlerta     AlertaCampoArquivo[]

  @@index([estabelecimentoId])
}

model DocumentoControlado {
  id                 String                       @id @default(cuid())
  estabelecimentoId  String
  codigo             String
  titulo             String
  categoria          CategoriaDocumentoControlado
  origem             OrigemDocumentoControlado    @default(INSTITUCIONAL)
  popId              String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  estabelecimento Estabelecimento   @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  pop             Pop?              @relation(fields: [popId], references: [id], onDelete: SetNull)
  versoes         DocumentoVersao[]
  vinculos        DocumentoVinculo[]
  treinamentos    Treinamento[]
  ocorrencias     OcorrenciaSeguranca[]

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId, categoria])
}

model DocumentoVersao {
  id              String                     @id @default(cuid())
  documentoId     String
  versao          String
  status          StatusDocumentoControlado  @default(RASCUNHO)
  responsavelId   String?
  dataVigencia    DateTime?
  dataRevisao     DateTime?
  proximaRevisao  DateTime?
  observacao      String?
  arquivoId       String?
  createdById     String?
  publicadoPorId  String?
  publicadoEm     DateTime?
  createdAt       DateTime                   @default(now())

  documento    DocumentoControlado @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  responsavel  Colaborador?        @relation("DocumentoVersaoResponsavel", fields: [responsavelId], references: [id])
  arquivo      ArquivoQualidade?   @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  createdBy    Usuario?            @relation("DocumentoVersaoAutor", fields: [createdById], references: [id], onDelete: SetNull)
  publicadoPor Usuario?            @relation("DocumentoVersaoPublicador", fields: [publicadoPorId], references: [id], onDelete: SetNull)

  @@index([documentoId, status])
}

model DocumentoVinculo {
  id               String               @id @default(cuid())
  documentoId      String
  tipo             TipoVinculoDocumento
  equipamentoId    String?
  modeloId         String?
  setorId          String?
  tipoIntervencao  String?

  documento   DocumentoControlado @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  equipamento Equipamento?        @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  modelo      Modelo?             @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  setor       Setor?              @relation(fields: [setorId], references: [id], onDelete: Cascade)

  @@index([documentoId])
  @@index([equipamentoId])
}

model Treinamento {
  id                 String                    @id @default(cuid())
  estabelecimentoId  String
  codigo             String
  tema               String
  tipo               TipoTreinamentoQualidade  @default(INICIAL)
  instrutorNome      String
  instrutorId        String?
  data               DateTime
  publico            String?
  documentoId        String?
  popId              String?
  arquivoId          String?
  observacao         String?
  createdById        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  estabelecimento Estabelecimento          @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  instrutor      Colaborador?             @relation(fields: [instrutorId], references: [id])
  documento      DocumentoControlado?     @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  pop            Pop?                     @relation(fields: [popId], references: [id], onDelete: SetNull)
  arquivo        ArquivoQualidade?        @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  createdBy      Usuario?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  equipamentos   TreinamentoEquipamento[]
  participantes  TreinamentoParticipante[]
  evidencias     TreinamentoEvidencia[]

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId, data])
}

model TreinamentoEquipamento {
  id             String @id @default(cuid())
  treinamentoId  String
  equipamentoId  String

  treinamento Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@unique([treinamentoId, equipamentoId])
}

model TreinamentoParticipante {
  id             String  @id @default(cuid())
  treinamentoId  String
  colaboradorId  String
  presente       Boolean @default(false)

  treinamento Treinamento @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@unique([treinamentoId, colaboradorId])
}

model TreinamentoEvidencia {
  id             String   @id @default(cuid())
  treinamentoId  String
  arquivoId      String
  createdAt      DateTime @default(now())

  treinamento Treinamento      @relation(fields: [treinamentoId], references: [id], onDelete: Cascade)
  arquivo     ArquivoQualidade @relation(fields: [arquivoId], references: [id], onDelete: Restrict)

  @@index([treinamentoId])
}

model OcorrenciaSeguranca {
  id                     String                    @id @default(cuid())
  estabelecimentoId      String
  codigo                 String
  tipo                   TipoOcorrenciaSeguranca
  status                 StatusOcorrenciaSeguranca @default(ABERTA)
  equipamentoId          String?
  setorId                String?
  dataOcorrido           DateTime
  descricao              String
  medidasImediatas       String?
  responsavelId          String?
  ordemServicoId         String?
  documentoId            String?
  naoConformidadeId      String?
  acessoSensivel         Boolean                   @default(false)
  condicaoUsoSugerida    String?
  condicaoUsoAplicadaEm  DateTime?
  condicaoUsoAplicadaPorId String?
  createdById            String?
  concludedAt            DateTime?
  concludedById          String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  estabelecimento     Estabelecimento         @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamento         Equipamento?            @relation(fields: [equipamentoId], references: [id])
  setor               Setor?                  @relation(fields: [setorId], references: [id])
  responsavel         Colaborador?            @relation(fields: [responsavelId], references: [id])
  ordemServico        OrdemServico?           @relation(fields: [ordemServicoId], references: [id])
  documento           DocumentoControlado?    @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  naoConformidade     NaoConformidade?        @relation(fields: [naoConformidadeId], references: [id], onDelete: SetNull)
  createdBy           Usuario?                @relation("OcorrenciaSegurancaAutor", fields: [createdById], references: [id], onDelete: SetNull)
  concludedBy         Usuario?                @relation("OcorrenciaSegurancaConclusao", fields: [concludedById], references: [id], onDelete: SetNull)
  condicaoUsoAplicadaPor Usuario?             @relation("OcorrenciaCondicaoUso", fields: [condicaoUsoAplicadaPorId], references: [id], onDelete: SetNull)
  investigacoes       OcorrenciaInvestigacao[]
  acoes               OcorrenciaAcao[]
  arquivos            OcorrenciaArquivo[]

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId, status])
  @@index([estabelecimentoId, tipo])
  @@index([equipamentoId])
  @@index([setorId])
  @@index([dataOcorrido])
}

model OcorrenciaInvestigacao {
  id           String   @id @default(cuid())
  ocorrenciaId String
  relato       String
  hipotese     String?
  createdById  String?
  createdAt    DateTime @default(now())

  ocorrencia OcorrenciaSeguranca @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  createdBy  Usuario?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ocorrenciaId])
}

model OcorrenciaAcao {
  id             String    @id @default(cuid())
  ocorrenciaId   String
  descricao      String
  responsavelNome String?
  prazo          DateTime?
  concluidoEm    DateTime?
  arquivoId      String?
  createdById    String?
  createdAt      DateTime  @default(now())

  ocorrencia OcorrenciaSeguranca @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  arquivo    ArquivoQualidade?   @relation(fields: [arquivoId], references: [id], onDelete: SetNull)
  createdBy  Usuario?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ocorrenciaId])
}

model OcorrenciaArquivo {
  id           String   @id @default(cuid())
  ocorrenciaId String
  arquivoId    String
  createdAt    DateTime @default(now())

  ocorrencia OcorrenciaSeguranca @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
  arquivo    ArquivoQualidade    @relation(fields: [arquivoId], references: [id], onDelete: Restrict)

  @@index([ocorrenciaId])
}

model AlertaCampo {
  id                            String           @id @default(cuid())
  estabelecimentoId             String
  codigo                        String
  tipo                          TipoAlertaCampo
  titulo                        String
  origem                        String
  dataRegistro                  DateTime         @default(now())
  prazo                         DateTime?
  responsavelId                 String?
  status                        StatusAlertaCampo @default(ABERTO)
  protocoloComunicacaoExterna   String?
  observacao                    String?
  createdById                   String?
  createdAt                     DateTime         @default(now())
  updatedAt                     DateTime         @updatedAt

  estabelecimento Estabelecimento         @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  responsavel     Colaborador?            @relation(fields: [responsavelId], references: [id])
  createdBy       Usuario?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  equipamentos    AlertaCampoEquipamento[]
  arquivos        AlertaCampoArquivo[]

  @@unique([estabelecimentoId, codigo])
  @@index([estabelecimentoId, tipo])
  @@index([estabelecimentoId, status])
}

model AlertaCampoEquipamento {
  id            String @id @default(cuid())
  alertaId      String
  equipamentoId String

  alerta      AlertaCampo @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  @@unique([alertaId, equipamentoId])
}

model AlertaCampoArquivo {
  id        String   @id @default(cuid())
  alertaId  String
  arquivoId String
  createdAt DateTime @default(now())

  alerta  AlertaCampo      @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  arquivo ArquivoQualidade @relation(fields: [arquivoId], references: [id], onDelete: Restrict)

  @@index([alertaId])
}
