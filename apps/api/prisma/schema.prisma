/// Encaminhamento à assistência externa vinculado a uma OS já existente.
model AtendimentoExterno {
  id                 String                     @id @default(cuid())
  estabelecimentoId  String
  ordemServicoId     String
  equipamentoId      String
  fornecedorId       String
  contratoId         String?
  status             StatusAtendimentoExterno   @default(ORCAMENTO)
  transporte         String?
  identificacaoEquipamento String?
  acessorios         String?
  origemSetorId      String?
  origemLocalizacao  String?
  enviadoEm          DateTime?
  previsaoRetorno    DateTime?
  retornadoEm        DateTime?
  foraDoHospital     Boolean                    @default(false)
  pendenciaRetorno   Boolean                    @default(false)
  conferenciaEm      DateTime?
  conferenciaPorId   String?
  conferenciaColabId String?
  conferenciaOk      Boolean?
  conferenciaObs     String?
  condicaoFinal      CondicaoUsoEquipamento?
  custoInformado     Decimal?                   @db.Decimal(14, 2)
  custoAprovado      Decimal?                   @db.Decimal(14, 2)
  custoRealizado     Decimal?                   @db.Decimal(14, 2)
  custoOsItemId      String?
  observacoes        String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  ordemServico    OrdemServico    @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  equipamento     Equipamento     @relation(fields: [equipamentoId], references: [id])
  fornecedor      Fornecedor      @relation(fields: [fornecedorId], references: [id])
  contrato        Contrato?       @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  conferenciaPor  Usuario?        @relation("AtendimentoConferencia", fields: [conferenciaPorId], references: [id], onDelete: SetNull)
  conferenciaColab Colaborador?   @relation("AtendimentoConferenciaColab", fields: [conferenciaColabId], references: [id], onDelete: SetNull)
  orcamentos      AtendimentoOrcamento[]
  documentos      AtendimentoExternoDocumento[]
  eventos         AtendimentoExternoEvento[]

