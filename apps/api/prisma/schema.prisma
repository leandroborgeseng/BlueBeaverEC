generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilAcesso {
  ENGENHEIRO
  GESTOR
  TECNICO
  TECNICO_RESTRITO
  SOLICITANTE
  AUDITORIA
  ADMIN
}

enum SituacaoEquipamento {
  ATIVO
  EM_GARANTIA
  EM_GARANTIA_ESTENDIDA
  INATIVO
  ARQUIVADO
}

enum Criticidade {
  BAIXA
  MEDIA
  ALTA
}

enum PrioridadeOS {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusOS {
  NAO_ATRIBUIDA
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO
  CONCLUIDA
  CANCELADA
}

enum VisibilidadeOs {
  PUBLICO
  INTERNO
}

enum CondicaoUsoEquipamento {
  APTO
  RESTRITO
  PARADO
}

enum PropriedadeEquipamento {
  PROPRIO
  LOCADO
  COMODATO
  OUTRO
}

enum TipoMovimentacaoEquipamento {
  TRANSFERENCIA_SETOR
  EMPRESTIMO
  ASSISTENCIA
  RETORNO
}

enum TipoDocumentoEquipamento {
  FOTO
  MANUAL
  GARANTIA
  NOTA_FISCAL
  EVIDENCIA_RECEBIMENTO
  EVIDENCIA_ENTRADA_OPERACAO
  EVIDENCIA_DESATIVACAO
  OUTRO
}

enum EventoCicloVida {
  RECEBIMENTO
  ENTRADA_OPERACAO
  DESATIVACAO
}

enum TipoOS {
  CORRETIVA
  PREVENTIVA
  CALIBRACAO
  TSE
  QUALIFICACAO
}

enum UrgenciaSolicitacao {
  BAIXA
  MEDIA
  ALTA
  PARADA_CRITICA
}

enum StatusSolicitacao {
  PENDENTE
  CONVERTIDA
  RECUSADA
}

model Estabelecimento {
  id              String   @id @default(cuid())
  nome            String
  cnpj            String?
  fusoHorario     String   @default("America/Sao_Paulo")
  slaUrgenteHoras         Int      @default(4)
  diasAlertaCertificado   Int      @default(60)
  bloquearPadraoVencido   Boolean  @default(true)
  /// R$/h de mão de obra. Sem valor, horas registram sem custo.
  valorHoraMaoDeObra      Decimal? @db.Decimal(14, 2)
  ativo                   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  usuarios               UsuarioEstabelecimento[]
  setores                Setor[]
  fabricantes            Fabricante[]
  fornecedores           Fornecedor[]
  planosDescricao        PlanoDescricao[]
  equipamentos           Equipamento[]
  ordensServico          OrdemServico[]
  solicitacoes           SolicitacaoServico[]
  estoqueItens           EstoqueItem[]
  procedimentosLaudo     ProcedimentoLaudo[]
  instrumentos           InstrumentoPadrao[]
  laudos                 Laudo[]
  contratos              Contrato[]
  atendimentosExternos   AtendimentoExterno[]
  equipes                Equipe[]
  componentesRecuperados ComponenteRecuperado[]
  auditorias             Auditoria[]
  naoConformidades       NaoConformidade[]
  avaliacoesMaturidade   AvaliacaoMaturidade[]
  jornadaEvolucao        JornadaEvolucao?
  evidenciasConformidade EvidenciaConformidade[]
  pops                   Pop[]
  recomendacoes          RecomendacaoInstitucional[]
  indicadores            Indicador[]
  indicadorSnapshots     IndicadorSnapshot[]
  planosDiretor          PlanoDiretorItem[]
  capexItens             CapexItem[]
  relatorioAgendamentos  RelatorioAgendamento[]
  perfisCustom           PerfilCustom[]
  mobileSyncIds          MobileSyncIdempotency[]
  tiposEquipamentoPlano  TipoEquipamentoPlano[]
  planosTipoCustom       PlanoTipoCustom[]
  planosGrupo            PlanoGrupo[]
  planosInstancia        PlanoInstancia[]
  planosOcorrencia       PlanoOcorrencia[]
  arquivosQualidade      ArquivoQualidade[]
  documentosControlados  DocumentoControlado[]
  treinamentos           Treinamento[]
  ocorrenciasSeguranca   OcorrenciaSeguranca[]
  alertasCampo           AlertaCampo[]
  osDominios             OsDominioValor[]
  padroesPreferenciais   PadraoPreferencial[]
}

model Usuario {
  id           String   @id @default(cuid())
  email        String   @unique
  nome         String
  senhaHash    String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  estabelecimentos UsuarioEstabelecimento[]
  colaborador      Colaborador?
  logsAcesso       LogAcesso[]
  historicoTags    HistoricoTag[]
  logsOS           LogOrdemServico[]
  comentariosOS    OsComentario[]
  anexosOS         OsAnexo[]
  movimentacoesEquip EquipamentoMovimentacao[]
  documentosEquip    EquipamentoDocumento[]
  eventosCicloEquip  EquipamentoEventoCiclo[]
  fornecedorDocumentos FornecedorDocumento[]
  fornecedorNotas      FornecedorNota[]
  contratoDocumentos   ContratoDocumento[]
  orcamentosDecididos  AtendimentoOrcamento[] @relation("OrcamentoDecisao")
  atendimentoEventos   AtendimentoExternoEvento[]
  atendimentoDocumentos AtendimentoExternoDocumento[]
  atendimentosConferencia AtendimentoExterno[] @relation("AtendimentoConferencia")
  arquivosQualidade       ArquivoQualidade[]
  documentosVersaoAutor   DocumentoVersao[] @relation("DocumentoVersaoAutor")
  documentosPublicados    DocumentoVersao[] @relation("DocumentoVersaoPublicador")
  treinamentosCriados     Treinamento[]
  ocorrenciasSegAutor     OcorrenciaSeguranca[] @relation("OcorrenciaSegurancaAutor")
  ocorrenciasSegConclusao OcorrenciaSeguranca[] @relation("OcorrenciaSegurancaConclusao")
  ocorrenciasInvestigacao OcorrenciaInvestigacao[]
  ocorrenciasAcoes        OcorrenciaAcao[]
  alertasCampoCriados     AlertaCampo[]
  ocorrenciasCondicaoUso  OcorrenciaSeguranca[] @relation("OcorrenciaCondicaoUso")
}

model UsuarioEstabelecimento {
  id                 String       @id @default(cuid())
  usuarioId          String
  estabelecimentoId  String
  perfil             PerfilAcesso
  setorIds           String[]     @default([])

  usuario         Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, estabelecimentoId])
}

model LogAcesso {
  id        String   @id @default(cuid())
  usuarioId String?
  acao      String
  detalhe   String?
  ip        String?
  createdAt DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
}

model Setor {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  nome               String
  ativo              Boolean @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamentos    Equipamento[]
  ordensServico   OrdemServico[]
  movimentacoesOrigem  EquipamentoMovimentacao[] @relation("MovOrigemSetor")
  movimentacoesDestino EquipamentoMovimentacao[] @relation("MovDestinoSetor")
  documentosVinculos   DocumentoVinculo[]
  ocorrenciasSeguranca OcorrenciaSeguranca[]

  @@unique([estabelecimentoId, nome])
}

model Fabricante {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  nome               String
  ativo              Boolean @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  modelos         Modelo[]
  equipamentos    Equipamento[]
  fornecedores    FornecedorFabricante[]

  @@unique([estabelecimentoId, nome])
}

model Modelo {
  id            String @id @default(cuid())
  fabricanteId  String
  nome          String
  ativo         Boolean @default(true)

  fabricante   Fabricante    @relation(fields: [fabricanteId], references: [id], onDelete: Cascade)
  equipamentos Equipamento[]
  procedimentos ProcedimentoModelo[]
  planosAplicados PlanoInstancia[]
  compatibilidadesEstoque EstoqueCompatibilidade[]
  documentosVinculos DocumentoVinculo[]

  @@unique([fabricanteId, nome])
}

model Fornecedor {
  id                 String   @id @default(cuid())
  estabelecimentoId  String
  nome               String
  cnpj               String?
  telefone           String?
  email              String?
  endereco           String?
  especialidades     String[] @default([])
  observacoes        String?
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamentos    Equipamento[]
  contratos       Contrato[]
  planosExecutor  PlanoInstancia[]
  ocorrenciasExecutor PlanoOcorrencia[] @relation("OcorrenciaFornecedor")
  contatos        FornecedorContato[]
  documentos      FornecedorDocumento[]
  notas           FornecedorNota[]
  fabricantes     FornecedorFabricante[]
  atendimentos    AtendimentoExterno[]

  @@unique([estabelecimentoId, nome])
}

model FornecedorContato {
  id           String  @id @default(cuid())
  fornecedorId String
  nome         String
  cargo        String?
  telefone     String?
  email        String?
  principal    Boolean @default(false)

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  @@index([fornecedorId])
}

model FornecedorDocumento {
  id            String   @id @default(cuid())
  fornecedorId  String
  tipo          String   @default("OUTRO")
  nomeArquivo   String
  mimeType      String
  conteudo      Bytes
  descricao     String?
  usuarioId     String?
  createdAt     DateTime @default(now())

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fornecedorId])
}

model FornecedorNota {
  id           String   @id @default(cuid())
  fornecedorId String
  texto        String
  usuarioId    String?
  createdAt    DateTime @default(now())

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fornecedorId, createdAt])
}

model FornecedorFabricante {
  id            String @id @default(cuid())
  fornecedorId  String
  fabricanteId  String

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  fabricante Fabricante @relation(fields: [fabricanteId], references: [id], onDelete: Cascade)

  @@unique([fornecedorId, fabricanteId])
}

model PlanoDescricao {
  id                   String      @id @default(cuid())
  estabelecimentoId    String
  nome                 String
  criticidade          Criticidade @default(MEDIA)
  vidaUtilAnos         Int         @default(10)
  /// Prazo em horas, a partir da abertura da OS, para o 1º atendimento.
  slaAtendimentoHoras  Int?
  /// Prazo em horas, a partir da abertura da OS, para conclusão.
  slaConclusaoHoras    Int?
  ativo                Boolean     @default(true)

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamentos    Equipamento[]

  @@unique([estabelecimentoId, nome])
}

/// Catálogo de tipo de equipamento para plano de manutenção (ex.: "Desfibrilador - cardioversor").
model TipoEquipamentoPlano {
  id                 String   @id @default(cuid())
  estabelecimentoId  String
  nome               String
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  testes          PlanoTeste[]
  equipamentos    Equipamento[]

  @@unique([estabelecimentoId, nome])
}

model PlanoTeste {
  id                    String         @id @default(cuid())
  tipoEquipamentoPlanoId String
  tipoTeste             TipoTestePlano
  periodicidadeMeses    Int
  procedimentoCodigo    String
  parametrosFaixa       String?
  tolerancias           String?
  classeTse             String?
  tipoParteAplicada     String?
  pontoAplicacao        String?
  ativo                 Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tipoEquipamentoPlano TipoEquipamentoPlano @relation(fields: [tipoEquipamentoPlanoId], references: [id], onDelete: Cascade)
  laudos               Laudo[]
  instancias           PlanoInstancia[]

  @@unique([tipoEquipamentoPlanoId, tipoTeste])
  @@index([procedimentoCodigo])
}

model CentroCusto {
  id                 String @id @default(cuid())
  estabelecimentoId  String
  codigo             String
  nome               String
  ativo              Boolean @default(true)

  equipamentos Equipamento[]

  @@unique([estabelecimentoId, codigo])
}

model Colaborador {
  id                 String  @id @default(cuid())
  estabelecimentoId  String
  usuarioId          String? @unique
  matricula          String
  nome               String
  cargo              String?
  registroProfissional String?
  ativo              Boolean @default(true)

  usuario          Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  osResponsavel    OrdemServico[] @relation("OSResponsavel")
  laudosResponsavel Laudo[]       @relation("LaudoResponsavelTecnico")
  equipes          EquipeMembro[]
  competencias     Competencia[]
  auditoriasResp   Auditoria[]    @relation("AuditoriaResponsavel")
  criticidadeEquipamentos Equipamento[] @relation("EquipCriticidadeResp")
  movimentacoesEquip EquipamentoMovimentacao[]
  planosResponsavel PlanoInstancia[] @relation("PlanoResponsavel")
  ocorrenciasExecutor PlanoOcorrencia[] @relation("OcorrenciaExecutor")
  atendimentosConferencia AtendimentoExterno[] @relation("AtendimentoConferenciaColab")
  documentosResponsavel DocumentoVersao[] @relation("DocumentoVersaoResponsavel")
  treinamentosInstrutor Treinamento[]
  treinamentosParticipante TreinamentoParticipante[]
  ocorrenciasSegResp    OcorrenciaSeguranca[]
  alertasCampoResp      AlertaCampo[]

  @@unique([estabelecimentoId, matricula])
}

model Equipamento {
  id                 String               @id @default(cuid())
  estabelecimentoId  String
  tag                String
  nome               String
  descricaoId        String
  fabricanteId       String
  modeloId           String
  setorId            String
  fornecedorId       String?
  centroCustoId      String?
  patrimonio         String?
  nSerie             String?
  dataAquisicao      DateTime?
  dataInstalacao     DateTime?
  valorAquisicao     Decimal?             @db.Decimal(14, 2)
  valorSubstituicao  Decimal?             @db.Decimal(14, 2)
  situacao           SituacaoEquipamento  @default(ATIVO)
  checklistRecebimentoPendente Boolean    @default(true)
  registroAnvisa     String?
  validadeAnvisa     DateTime?
  dataEndOfService   DateTime?
  dataEndOfLife      DateTime?
  observacao         String?
  condicaoUso        CondicaoUsoEquipamento @default(APTO)
  idInterna          String?
  unidade            String?
  localizacaoFisica  String?
  propriedade        PropriedadeEquipamento @default(PROPRIO)
  propriedadeOutra   String?
  garantiaInicio     DateTime?
  garantiaFim        DateTime?
  criticidadeEquipamento Criticidade?
  criticidadeJustificativa String?
  criticidadeResponsavelId String?
  qrToken            String?              @unique
  dataRecebimento    DateTime?
  dataEntradaOperacao DateTime?
  dataDesativacao    DateTime?
  motivoDesativacao  String?
  tipoEquipamentoPlanoId String?
  planoMatchTipo     String?   // exato | aproximado | sem_correspondencia
  planoMatchObs      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  descricao       PlanoDescricao  @relation(fields: [descricaoId], references: [id])
  fabricante      Fabricante      @relation(fields: [fabricanteId], references: [id])
  modelo          Modelo          @relation(fields: [modeloId], references: [id])
  setor           Setor           @relation(fields: [setorId], references: [id])
  fornecedor      Fornecedor?     @relation(fields: [fornecedorId], references: [id])
  centroCusto     CentroCusto?    @relation(fields: [centroCustoId], references: [id])
  tipoEquipamentoPlano TipoEquipamentoPlano? @relation(fields: [tipoEquipamentoPlanoId], references: [id], onDelete: SetNull)
  criticidadeResponsavel Colaborador? @relation("EquipCriticidadeResp", fields: [criticidadeResponsavelId], references: [id])
  historicoTags   HistoricoTag[]
  ordensServico   OrdemServico[]
  solicitacoes    SolicitacaoServico[]
  laudos          Laudo[]
  contratos       ContratoEquipamento[]
  componentesOrigem ComponenteRecuperado[] @relation("CompOrigem")
  componentesDestino ComponenteRecuperado[] @relation("CompDestino")
  movimentacoes   EquipamentoMovimentacao[]
  documentos      EquipamentoDocumento[]
  eventosCiclo    EquipamentoEventoCiclo[]
  planosManutencao PlanoInstancia[]
  atendimentosExternos AtendimentoExterno[]
  compatibilidadesEstoque EstoqueCompatibilidade[]
  documentosVinculos DocumentoVinculo[]
  treinamentosVinculos TreinamentoEquipamento[]
  ocorrenciasSeguranca OcorrenciaSeguranca[]
  alertasCampoVinculos AlertaCampoEquipamento[]

  @@unique([estabelecimentoId, tag])
  @@index([estabelecimentoId, situacao])
  @@index([estabelecimentoId, patrimonio])
  @@index([estabelecimentoId, nSerie])
  @@index([estabelecimentoId, idInterna])
  @@index([setorId])
  @@index([tipoEquipamentoPlanoId])
}

model HistoricoTag {
  id            String   @id @default(cuid())
  equipamentoId String
  tagAnterior   String
  tagNova       String
  justificativa String
  usuarioId     String
  createdAt     DateTime @default(now())

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])
}

model EquipamentoMovimentacao {
  id                 String                       @id @default(cuid())
  equipamentoId      String
  tipo               TipoMovimentacaoEquipamento
  origemSetorId      String?
  destinoSetorId     String?
  origemLocalizacao  String?
  destinoLocalizacao String?
  data               DateTime
  responsavelNome    String
  responsavelId      String?
  motivo             String
  usuarioId          String?
  createdAt          DateTime                     @default(now())

  equipamento Equipamento  @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  origemSetor Setor?       @relation("MovOrigemSetor", fields: [origemSetorId], references: [id])
  destinoSetor Setor?      @relation("MovDestinoSetor", fields: [destinoSetorId], references: [id])
  responsavel Colaborador? @relation(fields: [responsavelId], references: [id])
  usuario     Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([equipamentoId, data])
}

model EquipamentoDocumento {
  id            String                    @id @default(cuid())
  equipamentoId String
  tipo          TipoDocumentoEquipamento
  nomeArquivo   String
  mimeType      String
  conteudo      Bytes
  descricao     String?
  usuarioId     String?
  createdAt     DateTime                  @default(now())

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  eventosCiclo EquipamentoEventoCiclo[]

  @@index([equipamentoId])
}

model EquipamentoEventoCiclo {
  id            String          @id @default(cuid())
  equipamentoId String
  tipo          EventoCicloVida
  data          DateTime
  observacao    String?
  usuarioId     String?
  documentoId   String?
  createdAt     DateTime        @default(now())

  equipamento Equipamento           @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  usuario     Usuario?              @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  documento   EquipamentoDocumento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@index([equipamentoId, data])
}

model OrdemServico {
  id                 String       @id @default(cuid())
  estabelecimentoId  String
  numero             Int
  codigo             String?
  equipamentoId      String?
  setorId            String?
  tipo               TipoOS       @default(CORRETIVA)
  oficina            String?
  prioridade         PrioridadeOS @default(MEDIA)
  status             StatusOS     @default(NAO_ATRIBUIDA)
  abertura            DateTime     @default(now())
  fechamento         DateTime?
  responsavelId      String?
  pendencia          String?
  observacaoRequisicao String?
  solicitacaoId      String?      @unique
  contratoId         String?
  motivoAguardo      String?
  diagnostico        String?
  servicoRealizado   String?
  resultadoAtendimento String?
  condicaoFinal      CondicaoUsoEquipamento?
  equipamentoParado  Boolean      @default(false)
  impactoInformado   String?
  identificacaoPendente Boolean   @default(false)
  pedidoReaberturaJustificativa String?
  pedidoReaberturaEm DateTime?
  pedidoReaberturaPorId String?
  textoConclusaoPublico String?
  conclusaoSnapshot  String?
  atribuicaoVersao   Int          @default(0)
  complexidade       String?
  projeto            String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  estabelecimento Estabelecimento     @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  equipamento     Equipamento?        @relation(fields: [equipamentoId], references: [id])
  setor           Setor?              @relation(fields: [setorId], references: [id])
  responsavel     Colaborador?        @relation("OSResponsavel", fields: [responsavelId], references: [id])
  solicitacao     SolicitacaoServico? @relation(fields: [solicitacaoId], references: [id])
  logs            LogOrdemServico[]
  comentarios     OsComentario[]
  anexos          OsAnexo[]
  itens           OrdemServicoItem[]
  reservas        EstoqueReserva[]
  contrato        Contrato?           @relation(fields: [contratoId], references: [id])
  naoConformidades NaoConformidade[]
  checklistMobile OsChecklistMobile?
  fotosMobile     OsFotoMobile[]
  ocorrenciaPlano PlanoOcorrencia?
  atendimentosExternos AtendimentoExterno[]
  ocorrenciasSeguranca OcorrenciaSeguranca[]

  @@unique([estabelecimentoId, numero])
  @@index([estabelecimentoId, status])
  @@index([equipamentoId])
  @@index([setorId])
}

model OsDominioValor {
  id                String   @id @default(cuid())
  estabelecimentoId String
  tipo              String
  codigo            String?
  nome              String
  ativo             Boolean  @default(true)
  ordem             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  estabelecimento Estabelecimento @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)

  @@unique([estabelecimentoId, tipo, nome])
  @@index([estabelecimentoId, tipo])
}

model LogOrdemServico {
  id             String         @id @default(cuid())
  ordemServicoId String
  usuarioId      String?
  acao           String
  justificativa  String?
  visibilidade   VisibilidadeOs @default(PUBLICO)
  createdAt      DateTime       @default(now())

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
