# Shared / Coolify
NODE_ENV=production
POSTGRES_USER=aion
POSTGRES_PASSWORD=aion_change_me
POSTGRES_DB=aion
DATABASE_URL=postgresql://aion:aion_change_me@db:5432/aion?schema=public

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Web: vazio = browser chama /api no mesmo domínio (proxy Next → API).
# Em dev local pode apontar direto para a Nest:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Railway (serviço web) — HTTP (nunca https) no host interno:
#   na API:  PORT=3001
#   no web:  API_INTERNAL_URL=http://aionapi.railway.internal:3001
# Alternativa estável: Generate Domain na API e use https://….up.railway.app
API_INTERNAL_URL=http://127.0.0.1:3001
API_INTERNAL_PORT=3001
