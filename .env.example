# Shared / Coolify
NODE_ENV=production
POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo_change_me
POSTGRES_DB=nexo
DATABASE_URL=postgresql://nexo:nexo_change_me@db:5432/nexo?schema=public

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Web: vazio = browser chama /api no mesmo domínio (proxy Next → API).
# Em dev local pode apontar direto para a Nest:
NEXT_PUBLIC_API_URL=http://localhost:3001
# No Railway (web), use a URL privada da API, ex.:
# API_INTERNAL_URL=http://${{nexo-api.RAILWAY_PRIVATE_DOMAIN}}:${{nexo-api.PORT}}
API_INTERNAL_URL=http://127.0.0.1:3001
