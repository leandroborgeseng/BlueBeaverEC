# Shared / Coolify
NODE_ENV=production
POSTGRES_USER=aion
POSTGRES_PASSWORD=aion_change_me
POSTGRES_DB=aion
DATABASE_URL=postgresql://aion:aion_change_me@db:5432/aion?schema=public

# API
API_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Web: vazio = browser chama /api no mesmo domínio (proxy Next → API).
# Em dev local pode apontar direto para a Nest:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Railway (@nexo/web). TCP privado (*.railway.internal) pode estar morto mesmo
# com deploy verde. Caminho que funciona: Generate Domain na API + HTTPS público.
#   API_INTERNAL_URL=https://<api>.up.railway.app
#   API_PUBLIC_URL=https://<api>.up.railway.app
# Sem barra no fim e sem /api. Referência privada (só se o TCP interno responder):
#   API_INTERNAL_URL=http://${{@nexo/api.RAILWAY_PRIVATE_DOMAIN}}:${{@nexo/api.PORT}}
API_INTERNAL_URL=http://127.0.0.1:3001
API_INTERNAL_PORT=3001
# API_PUBLIC_URL=

# Relatórios agendados (opcional)
# RELATORIOS_CRON=0  # desliga o cron horário
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=aion@example.com
